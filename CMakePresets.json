{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "host-debug",
            "displayName": "Host Debug",
            "description": "Native host build with debug symbols",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/out/host-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "BUILD_TESTING": "ON"
            }
        },
        {
            "name": "host-release",
            "displayName": "Host Release",
            "description": "Native host release build",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/out/host-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "BUILD_TESTING": "ON"
            }
        },
        {
            "name": "host-sanitize",
            "displayName": "Host Sanitizers",
            "description": "Native host build with AddressSanitizer and UBSan",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/out/host-sanitize",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
                "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
                "BUILD_TESTING": "ON"
            }
        },
        {
            "name": "arm-debug",
            "displayName": "T113 ARM Debug",
            "description": "T113 ARM cross-build with debug symbols",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/out/arm-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/toolchain-t113.cmake",
                "BUILD_TESTING": "OFF"
            }
        },
        {
            "name": "arm-release",
            "displayName": "T113 ARM Release",
            "description": "T113 ARM cross-build for deployment",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/out/arm-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/toolchain-t113.cmake",
                "BUILD_TESTING": "OFF"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "host-debug",
            "configurePreset": "host-debug"
        },
        {
            "name": "host-release",
            "configurePreset": "host-release"
        },
        {
            "name": "host-sanitize",
            "configurePreset": "host-sanitize"
        },
        {
            "name": "arm-debug",
            "configurePreset": "arm-debug"
        },
        {
            "name": "arm-release",
            "configurePreset": "arm-release"
        }
    ],
    "testPresets": [
        {
            "name": "host-debug",
            "configurePreset": "host-debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "host-release",
            "configurePreset": "host-release",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "host-sanitize",
            "configurePreset": "host-sanitize",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
