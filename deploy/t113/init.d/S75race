#!/bin/sh

case "${1:-start}" in
    start) /opt/t113/bin/start_race.sh ;;
    stop) /opt/t113/bin/stop_race.sh ;;
    restart)
        /opt/t113/bin/stop_race.sh || true
        /opt/t113/bin/start_race.sh
        ;;
    status)
        if [ -x /opt/t113/bin/race_core_status_dump ]; then
            /opt/t113/bin/race_core_status_dump || true
        fi
        for name in race_supervisor race_core race_video webd health_log t113_watchdog; do
            pid_file="/run/race/${name}.pid"
            if [ -r "$pid_file" ] && kill -0 "$(sed -n '1p' "$pid_file")" 2>/dev/null; then
                echo "$name: running ($(sed -n '1p' "$pid_file"))"
            else
                echo "$name: stopped"
            fi
        done
        ;;
    *) echo "Usage: $0 {start|stop|restart|status}" >&2; exit 1 ;;
esac
